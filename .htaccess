# Canonical host: keep every path and query string on the HTTPS apex domain.
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteCond %{HTTP_HOST} ^www\.mybreakeven\.com$ [NC]
RewriteRule ^ https://mybreakeven.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

# Vite includes a content hash in built JS/CSS filenames. New builds get new
# URLs, so these files can be cached for a year without serving an old build.
# Keep HTML and stable public filenames on the hosting provider's shorter TTL.
<IfModule mod_headers.c>
<FilesMatch "-[A-Za-z0-9_-]{8}\.(js|css)$">
Header set Cache-Control "public, max-age=31536000, immutable"
</FilesMatch>
</IfModule>
